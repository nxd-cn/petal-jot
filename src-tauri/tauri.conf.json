{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetalJot",
  "version": "0.1.0",
  "identifier": "com.nixiaodong.petaljot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "orb",
        "title": "PetalJot",
        "url": "orb.html",
        "width": 56,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "shadow": false,
        "backgroundColor": "#00000000",
        "x": 120,
        "y": 120,
        "noRedirectionBitmap": true
      },
      {
        "label": "editor",
        "title": "PetalJot",
        "url": "editor.html",
        "width": 480,
        "height": 640,
        "resizable": true,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#f4f4f5"
      },
      {
        "label": "settings",
        "title": "PetalJot Settings",
        "url": "settings.html",
        "width": 420,
        "height": 480,
        "resizable": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#dfdfdb"
      },
      {
        "label": "search",
        "title": "PetalJot Search",
        "url": "search.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
